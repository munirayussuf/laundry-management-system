# Copy to .env for local development. Never commit real gateway credentials.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
AT_SMS_URL=

MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=
MPESA_CALLBACK_URL=https://YOUR_PUBLIC_HOST/api/payments/mpesa/callback
MPESA_CALLBACK_TOKEN=replace-with-a-long-random-secret

# Configure the aggregator callback URL with this query parameter:
# https://YOUR_PUBLIC_HOST/ussd?token=YOUR_USSD_CALLBACK_TOKEN
USSD_CALLBACK_TOKEN=replace-with-another-long-random-secret
